generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MODDER
  ADMIN
}

enum ServiceCategory {
  CASE_AND_ACOUSTIC
  SWITCH_MODS
  STABILIZER_MODS
  CUSTOMIZATION_AESTHETICS
}

enum ServiceOptionType {
  LUBE_TYPE
  NEW_SWITCH
  ADDON_SERVICE
  FOAM_TYPE
}

enum BookingDeliveryMethod {
  COURIER
  WALK_IN
}

enum BookingStatus {
  UNPAID
  PENDING_ADMIN_VERIFICATION
  PAID_WAITING_MODDER
  CUSTOMER_SENDING_KEYBOARD
  KEYBOARD_IN_MODDER_HAND
  SHIPPED_BACK
  SUCCESS
  UNDER_DISPUTE
}

model User {
  id               String      @id @default(uuid())
  name             String
  email            String      @unique
  password         String
  role             Role        @default(CUSTOMER)
  isVerified       Boolean     @default(false)
  locationCity     String
  avgRating        Float       @default(0.0)
  createdAt        DateTime    @default(now())
  portfolios       Portfolio[]
  services         Service[]   @relation("ModderServices")
  bookingsAsCustomer Booking[]  @relation("CustomerBookings")
  bookingsAsModder  Booking[]   @relation("ModderBookings")
  reviewsAsCustomer Review[]    @relation("CustomerReviews")
  reviewsAsModder   Review[]    @relation("ModderReviews")

  @@map("user")
}

model Portfolio {
  id          String   @id @default(uuid())
  modderId    String
  modder      User     @relation(fields: [modderId], references: [id], onDelete: Cascade)
  imageKey    String
  title       String
  description String
  createdAt   DateTime @default(now())

  @@map("portfolio")
}

model Service {
  id          String           @id @default(uuid())
  modderId    String
  modder      User             @relation("ModderServices", fields: [modderId], references: [id], onDelete: Cascade)
  title       String
  description String
  basePrice   Float
  category    ServiceCategory
  options     ServiceOption[]
  bookingItems BookingItem[]

  @@map("service")
}

model ServiceOption {
  id          String            @id @default(uuid())
  serviceId   String
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  optionName  String
  optionType  ServiceOptionType
  extraPrice  Float             @default(0.0)

  @@map("service_option")
}

model Booking {
  id                  String             @id @default(uuid())
  customerId          String
  customer            User               @relation("CustomerBookings", fields: [customerId], references: [id])
  modderId            String
  modder              User               @relation("ModderBookings", fields: [modderId], references: [id])
  keyboardModel       String
  deliveryMethod      BookingDeliveryMethod
  totalPrice          Float
  bookingDate         DateTime
  status              BookingStatus      @default(UNPAID)
  createdAt           DateTime           @default(now())
  proposedDate        DateTime?
  paymentProof        String?
  inboundTrackingNum  String?
  outboundTrackingNum String?
  items               BookingItem[]
  review              Review?

  @@unique([modderId, bookingDate])
  @@map("booking")
}

model BookingItem {
  id              String   @id @default(uuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])
  selectedOptions Json
  subTotal        Float

  @@map("booking_item")
}

model Review {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId  String
  customer    User     @relation("CustomerReviews", fields: [customerId], references: [id])
  modderId    String
  modder      User     @relation("ModderReviews", fields: [modderId], references: [id])
  rating      Int
  comment     String
  createdAt   DateTime @default(now())

  @@map("review")
}