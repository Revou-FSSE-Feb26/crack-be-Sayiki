{
  "info": {
    "_postman_id": "9b1a5e12-38ef-4a6c-9c71-2bfa92bc09a1",
    "name": "SwitchLab Auth API",
    "description": "Authentication API collection for REVOU crack project (SwitchLab backend).\nIncludes endpoints for Register, Login (JWT), and Protected Profile (/auth/me).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Register Customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"email\": \"budi.santoso@switchlab.local\",\n  \"password\": \"password123\",\n  \"role\": \"CUSTOMER\",\n  \"locationCity\": \"Jakarta\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "Registers a new Customer user. Password will be hashed securely using bcrypt."
      },
      "response": []
    },
    {
      "name": "2. Register Modder",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Gilang Modder\",\n  \"email\": \"gilang.modder@switchlab.local\",\n  \"password\": \"password123\",\n  \"role\": \"MODDER\",\n  \"locationCity\": \"Surabaya\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "Registers a new Modder user."
      },
      "response": []
    },
    {
      "name": "3. Register Duplicate Email (Expect 409 Conflict)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"budi.santoso@switchlab.local\",\n  \"password\": \"password123\",\n  \"role\": \"CUSTOMER\",\n  \"locationCity\": \"Jakarta\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "Attempts to register with an already existing email. Should return 409 Conflict."
      },
      "response": []
    },
    {
      "name": "4. Login Success (Generates JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.access_token) {",
              "        pm.collectionVariables.set(\"token\", jsonData.access_token);",
              "        console.log(\"Saved JWT access token to collection variable 'token'\");",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"budi.santoso@switchlab.local\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Authenticates user credentials, compares bcrypt hash, and returns signed JWT access token. Saves token in collection variable for subsequent requests."
      },
      "response": []
    },
    {
      "name": "5. Login Invalid Password (Expect 401 Unauthorized)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"budi.santoso@switchlab.local\",\n  \"password\": \"wrongpassword\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Attempts login with incorrect password. Should return 401 Unauthorized."
      },
      "response": []
    },
    {
      "name": "6. Get Current User Profile (Protected - Bearer Token)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        },
        "description": "Fetches currently authenticated user's profile using the JWT Bearer token."
      },
      "response": []
    },
    {
      "name": "7. Get Me Unauthorized (Expect 401 Unauthorized)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        },
        "description": "Calls protected route without Authorization header. Should return 401 Unauthorized."
      },
      "response": []
    }
  ]
}
